digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
goal_guarded_root [label="goal_guarded_root", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
GoalCheck_Pre [label="GoalCheck_Pre", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
goal_guarded_root -> GoalCheck_Pre;
retry_until_goal [label="retry_until_goal", shape=ellipse, style=filled, fillcolor=ghostwhite, fontsize=9, fontcolor=black];
goal_guarded_root -> retry_until_goal;
attempt [label="Ⓜ attempt", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
retry_until_goal -> attempt;
pddl_plan_sequence [label="Ⓜ pddl_plan_sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
attempt -> pddl_plan_sequence;
"PickSeq(yellow_cube)" [label="Ⓜ PickSeq(yellow_cube)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PickSeq(yellow_cube)";
"PickUp(yellow_cube)" [label="PickUp(yellow_cube)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(yellow_cube)" -> "PickUp(yellow_cube)";
"Holding(yellow_cube)" [label="Holding(yellow_cube)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(yellow_cube)" -> "Holding(yellow_cube)";
"PlaceSeq(yellow_cube->pot)" [label="Ⓜ PlaceSeq(yellow_cube->pot)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PlaceSeq(yellow_cube->pot)";
"PlaceInBin(yellow_cube->pot)" [label="PlaceInBin(yellow_cube->pot)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(yellow_cube->pot)" -> "PlaceInBin(yellow_cube->pot)";
"On(yellow_cube->pot)" [label="On(yellow_cube->pot)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(yellow_cube->pot)" -> "On(yellow_cube->pot)";
"PickSeq(red_can)" [label="Ⓜ PickSeq(red_can)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PickSeq(red_can)";
"PickUp(red_can)" [label="PickUp(red_can)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(red_can)" -> "PickUp(red_can)";
"Holding(red_can)" [label="Holding(red_can)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(red_can)" -> "Holding(red_can)";
"PlaceSeq(red_can->sorting_bin)" [label="Ⓜ PlaceSeq(red_can->sorting_bin)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PlaceSeq(red_can->sorting_bin)";
"PlaceInBin(red_can->sorting_bin)" [label="PlaceInBin(red_can->sorting_bin)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(red_can->sorting_bin)" -> "PlaceInBin(red_can->sorting_bin)";
"On(red_can->sorting_bin)" [label="On(red_can->sorting_bin)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(red_can->sorting_bin)" -> "On(red_can->sorting_bin)";
"PickSeq(blue_can)" [label="Ⓜ PickSeq(blue_can)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PickSeq(blue_can)";
"PickUp(blue_can)" [label="PickUp(blue_can)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(blue_can)" -> "PickUp(blue_can)";
"Holding(blue_can)" [label="Holding(blue_can)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PickSeq(blue_can)" -> "Holding(blue_can)";
"PlaceSeq(blue_can->sorting_bin)" [label="Ⓜ PlaceSeq(blue_can->sorting_bin)", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
pddl_plan_sequence -> "PlaceSeq(blue_can->sorting_bin)";
"PlaceInBin(blue_can->sorting_bin)" [label="PlaceInBin(blue_can->sorting_bin)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(blue_can->sorting_bin)" -> "PlaceInBin(blue_can->sorting_bin)";
"On(blue_can->sorting_bin)" [label="On(blue_can->sorting_bin)", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
"PlaceSeq(blue_can->sorting_bin)" -> "On(blue_can->sorting_bin)";
GoalCheck_Post [label="GoalCheck_Post", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
attempt -> GoalCheck_Post;
}
